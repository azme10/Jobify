# LLM inference runs entirely locally through Ollama — no API key, no hosted provider.
# Setup: install Ollama, `ollama pull qwen2.5:7b`, then build the 8192-context variant:
#   ollama create qwen2.5-7b-8192 -f Qwen25.modelfile
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-7b-8192
